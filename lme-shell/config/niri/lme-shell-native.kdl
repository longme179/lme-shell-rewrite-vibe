// LME Shell — native edition integration fragment for niri 25.11+.
// Do not replace your niri configuration. Remove existing binds with these
// same keys before merging this fragment. The daemon never edits
// ~/.config/niri/config.kdl.
//
// Start the shell from niri:
spawn-sh-at-startup "lme-shell" "daemon"

// Keybindings — same shortcuts as the legacy QML shell (config/niri/lme-shell.kdl),
// now mapped to the native daemon's msg CLI.
binds {
    Mod+Space hotkey-overlay-title="Open application launcher" {
        spawn "lme-shell" "msg" "toggle" "launcher";
    }
    Mod+Shift+E hotkey-overlay-title="Open power menu" {
        spawn "lme-shell" "msg" "toggle" "power";
    }
    Mod+Tab hotkey-overlay-title="Window overview" { toggle-overview; }
    // Panels not yet implemented in this build reply with an OSD notice:
    Mod+A hotkey-overlay-title="Open control center" {
        spawn "lme-shell" "msg" "toggle" "control";
    }
    Mod+N hotkey-overlay-title="Open notifications" {
        spawn "lme-shell" "msg" "toggle" "notifications";
    }
    Mod+V hotkey-overlay-title="Clipboard history" {
        spawn "lme-shell" "msg" "toggle" "clipboard";
    }
    Mod+Shift+Tab hotkey-overlay-title="Workspace board" {
        spawn "lme-shell" "msg" "toggle" "overview";
    }
    Mod+Shift+A hotkey-overlay-title="Activity island" {
        spawn "lme-shell" "msg" "toggle" "activity";
    }
    Mod+Comma hotkey-overlay-title="Open shell settings" {
        spawn "lme-shell" "settings";
    }
}

// Media keys (optional): show the native OSD like the legacy shell.
// Adjust to your player/volume tooling; examples:

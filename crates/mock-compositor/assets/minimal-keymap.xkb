xkb_keymap {
    xkb_keycodes "minimal" {
        minimum = 8;
        maximum = 118;
        <ESC> = 9;
        <BKSP> = 22;
        <RTRN> = 36;
        <LFSH> = 50;
        <AD01> = 24;
        <AD02> = 25;
        <AD03> = 26;
        <AD04> = 27;
        <AD05> = 28;
        <AD06> = 29;
        <AD07> = 30;
        <AD08> = 31;
        <AD09> = 32;
        <AD10> = 33;
        <AC01> = 38;
        <AC02> = 39;
        <AC03> = 40;
        <AC04> = 41;
        <AC05> = 42;
        <UP> = 111;
        <LEFT> = 113;
        <RGHT> = 114;
        <DOWN> = 116;
    };
    xkb_types "minimal" {
        type "ONE_LEVEL" {
            modifiers = none;
            map[none] = Level1;
            level_name[Level1] = "Any";
        };
        type "TWO_LEVEL" {
            modifiers = Shift;
            map[none] = Level1;
            map[Shift] = Level2;
            level_name[Level1] = "Base";
            level_name[Level2] = "Shift";
        };
    };
    xkb_compat "minimal" {
        interpret.repeat = False;
        interpret Shift_L+Exactly(Shift) {
            action = SetMods(modifiers = Shift);
        };
    };
    xkb_symbols "minimal" {
        name[Group1] = "English (US)";
        key <ESC>  { [ Escape ] };
        key <BKSP> { [ BackSpace ] };
        key <RTRN> { [ Return ] };
        key <LFSH> { [ Shift_L ] };
        key <AD01> { [ q, Q ] };
        key <AD02> { [ w, W ] };
        key <AD03> { [ e, E ] };
        key <AD04> { [ r, R ] };
        key <AD05> { [ t, T ] };
        key <AD06> { [ y, Y ] };
        key <AD07> { [ u, U ] };
        key <AD08> { [ i, I ] };
        key <AD09> { [ o, O ] };
        key <AD10> { [ p, P ] };
        key <AC01> { [ a, A ] };
        key <AC02> { [ s, S ] };
        key <AC03> { [ d, D ] };
        key <AC04> { [ f, F ] };
        key <AC05> { [ g, G ] };
        key <UP>   { [ Up ] };
        key <LEFT> { [ Left ] };
        key <RGHT> { [ Right ] };
        key <DOWN> { [ Down ] };
        modifier_map Shift { <LFSH> };
    };
    xkb_geometry "minimal" { };
};

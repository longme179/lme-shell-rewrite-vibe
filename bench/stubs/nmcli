#!/usr/bin/env bash
"$(dirname "$0")/_log.sh" nmcli "$@"
if [ "$1" = "radio" ] && [ "$2" = "wifi" ]; then printf 'enabled\n'
elif [ "$1" = "-t" ]; then
  if [ "$4" = "TYPE,STATE,CONNECTION" ]; then printf 'wifi:connected:HomeNet\nethernet:disconnected:\n'
  elif [ "$4" = "ACTIVE,SSID,SIGNAL" ]; then printf 'yes:HomeNet:88\nno:Guest:45\n' ; fi
fi
exit 0
